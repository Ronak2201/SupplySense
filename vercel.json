{
  "version": 2,
  "public": true,
  "functions": {
    "api/verify.js": {
      "maxDuration": 60
    },
    "api/agent-stream.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}